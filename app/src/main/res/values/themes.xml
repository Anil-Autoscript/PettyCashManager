<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.PettyCashManager" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorError">@color/colorError</item>
        <item name="android:statusBarColor">@color/blue_800</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/colorBackground</item>

        <!-- Material component overrides -->
        <item name="materialCardViewStyle">@style/AppCardView</item>
        <item name="bottomNavigationStyle">@style/AppBottomNav</item>
        <item name="textInputStyle">@style/AppTextInput</item>
        <item name="materialButtonStyle">@style/AppButton</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.PettyCashManager.Splash" parent="Theme.PettyCashManager">
        <item name="android:statusBarColor">@color/blue_900</item>
        <item name="android:windowBackground">@color/blue_800</item>
    </style>

    <!-- Card Style -->
    <style name="AppCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="AppBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Text Input -->
    <style name="AppTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/blue_400</item>
        <item name="hintTextColor">@color/blue_600</item>
    </style>

    <!-- Button -->
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Dashboard Balance Card -->
    <style name="DashboardBalanceCard" parent="AppCardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">8dp</item>
    </style>

    <!-- Transaction Item -->
    <style name="TransactionCard" parent="AppCardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:layout_marginVertical">4dp</item>
    </style>
</resources>
